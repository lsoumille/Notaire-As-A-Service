{
  "name": "transmission-facile-by-l'ingé-patrimoine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:wrangler\"",
    "dev:vite": "vite build --watch --emptyOutDir",
    "dev:wrangler": "npx wrangler dev --port 8787",
    "build": "vite build && cp .assetsignore dist/ && npx wrangler pages functions build --outdir=./dist/_worker.js",
    "preview": "vite preview",
    "test:api": "npx tsx test-chat-api.ts",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.4.1"
  }
}
